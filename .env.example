# Token del bot Telegram (obbligatorio). In Cursor Cloud Agent è già disponibile come secret.
TELEGRAM_BOT_TOKEN=

# Telegram user id admin / supporto (/deal, /log, force payout, /iscritti…).
# Singolo (legacy) e/o lista (csv). Almeno uno in prod.
# Force /payseller|/refundbuyer solo in disputa; non-admin → delete messaggio.
# Group-loss: DM su bot kick / gruppo cancellato / wipe card / admin kickato.
# Dispute aperte: DM admin **off** di default (operatore apre il gruppo quando vuole).
# DISPUTE_ADMIN_NOTIFY=1  # solo se vuoi di nuovo le notify su ogni disputa
# In DM (gruppo perso): /payseller <dealId> · /refundbuyer <dealId>
ADMIN_TELEGRAM_ID=
# ADMIN_TELEGRAM_IDS=111111111,222222222

# Host pubblico HTTPS del Web Service (obbligatorio per Mini App ToS).
# Serve un servizio Web (non solo Background Worker) con PORT aperto.
# Mini App: GET /tos · Accetta deal: POST /api/tos/accept
# Su Render: PUBLIC_BASE_URL=https://<servizio>.onrender.com
# (oppure RENDER_EXTERNAL_URL se già presente).
# PUBLIC_BASE_URL=https://telegram-escrow-it.onrender.com
#
# Override opzionale dell’URL Mini App (default = ${PUBLIC_BASE_URL}/tos).
# TOS_URL=https://telegram-escrow-it.onrender.com/tos
#
# Senza host: «Leggi i Termini» → fallback corto; Accetta resta callback in gruppo.

# --- Path preferito: helper crea il gruppo (owner = account supporto) ---
# TELEGRAM_BOT_CREATES_GROUPS è ON di default. Senza le tre env sotto → fallback manuale.
# 1) https://my.telegram.org → crea app → api_id + api_hash
# 2) locale: TELEGRAM_API_ID=… TELEGRAM_API_HASH=… npm run helper:login
# 3) copia la session string su Render Environment (Background Worker)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_HELPER_SESSION=
# TELEGRAM_BOT_CREATES_GROUPS=0  # solo per forzare path manuale legacy

# --- Solana MAINNET escrow (obbligatorio per /crea on-chain) ---
# Genera con: npm run solana:keygen
# Metti il secret SOLO su Render (Background Worker / Web Service) — mai in git.
# Formato: base58 oppure JSON array di 64 numeri.
# Master = fee-payer rete + destinazione fee 5% release (default).
SOLANA_PRIVATE_KEY=

# Destinazione fee piattaforma (pubkey base58). Se assente = master pubkey.
# In produzione Imposta SEMPRE il wallet fee di Francesco (5% release senza invito):
FEE_WALLET_PUBKEY=57fv8agNAjcsaLgodeNDjexTo5azsJpjLyMigaZnfVNP

# RPC Solana (opzionale). Default: https://api.mainnet-beta.solana.com
# In produzione preferisci Helius / QuickNode / Alchemy (rate limit del pubblico).
# SOLANA_RPC_URL=https://YOUR_PROVIDER_RPC

# Intervallo poll depositi in ms (opzionale, default 20000).
# SOLANA_WATCH_INTERVAL_MS=20000

# Cartella store JSON (opzionale, default data → risolto ad assoluto).
# Su Render: obbligatorio Persistent Disk mount /var/data + DATA_DIR=/var/data
# Path **assoluto** con slash iniziale. NON usare `var/data` (relativo → /app/var/data,
# Persistent Disk resta vuoto; /codice scrive fuori dal volume e /crea non vede il codice).
# File: deals.json, members.json, invites.json, deal-logs.json, vouch-tos-pin.json
# DATA_DIR=data
# DATA_DIR=/var/data

# --- Contatore pubblico iscritti (stile CoinXpert «N iscritti») ---
# Canale Telegram dove pubblicare il conteggio. Il bot deve essere *admin* del canale.
# Accetta id numerico (-100…) o @username del canale.
# UPDATES_CHANNEL_ID=@EscrowitaUpdates
# UPDATES_CHANNEL_ID=-1001234567890
#
# Opzionale: message_id di un messaggio vivente (idealmente fissato) da aggiornare.
# Se assente, il bot aggiorna la *description* del canale con «N iscritti».
# UPDATES_CHANNEL_MESSAGE_ID=42

# --- Canale vouch / recensioni (post dual-confirm pay-seller) ---
# Obbligatorio in prod: gate /crea + post review.
# Bot = admin del canale con permesso «Gestire i messaggi» (Post) only
# (serve anche getChatMember per verificare iscrizione utente).
# Preferire id numerico (-100…). Id: inoltra un msg del canale a
# @userinfobot / @getidsbot. Fallimenti post → log ERROR `[vouch] FAIL …`.
# VOUCH_CHANNEL_ID=-1001234567890
#
# Link invito mostrato a /start (default sotto). Override su Render se ruoti il link.
# VOUCH_INVITE_LINK=https://t.me/+tww-HqO8htBiMzdk

